{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "cart": {
        "ClusterId": "cart",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/stock/{**catch-all}" }
      },
      "order": {
        "ClusterId": "order",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://identity:8080/" } }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalog:8080/" } }
      },
      "cart": {
        "Destinations": { "d1": { "Address": "http://cart:8080/" } }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://inventory:8080/" } }
      },
      "order": {
        "Destinations": { "d1": { "Address": "http://order:8080/" } }
      },
      "payment": {
        "Destinations": { "d1": { "Address": "http://payment:8080/" } }
      }
    }
  }
}
