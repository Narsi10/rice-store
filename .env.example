# Copy this to ".env" on your server and fill in real values.
# docker compose -f docker-compose.prod.yml --env-file .env up --build -d

# SQL Server SA password (min 8 chars, upper+lower+digit+symbol)
DB_PASSWORD=ChangeMe_Strong123!

# JWT signing key for Identity (use a long random string, 32+ chars)
JWT_KEY=change-this-to-a-long-random-secret-key-32b+

# Initial admin account (seeded on first run). Use your own values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_FULLNAME=Administrator

# Brevo SMTP (from Brevo -> SMTP & API -> SMTP tab)
EMAIL_SMTP_LOGIN=b7bc57001@smtp-brevo.com
EMAIL_SMTP_KEY=your-xsmtpsib-key-here
EMAIL_FROM=yaldandanarsireddy@gmail.com

# Your domain (without https://). Caddy uses this to get TLS certs and route:
#   https://SITE_DOMAIN         -> frontend
#   https://api.SITE_DOMAIN     -> gateway
# Point both an A record for SITE_DOMAIN and api.SITE_DOMAIN at your server IP.
SITE_DOMAIN=ricestore.example.com

# Public URL where the API gateway is reachable from the browser.
# With Caddy + domain (recommended):  https://api.ricestore.example.com
# Without a domain (HTTP, IP only):   http://YOUR_SERVER_IP:8000
FRONTEND_GATEWAY_URL=https://api.ricestore.example.com
